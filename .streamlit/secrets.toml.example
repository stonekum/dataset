# Streamlit Secrets 模板
#
# 使用方法：
#   1. 把本文件复制为 .streamlit/secrets.toml（已被 gitignore，不会进仓库）
#   2. 按下方说明填入对应区段的值
#   3. Streamlit Cloud 部署：到 App Settings → Secrets 把本文件内容整段粘贴
#
# 各区段独立可选：未填写的区段对应功能会自动隐藏，其他功能照常运行。

# ============================================================
# [meta_graph] — Meta Graph API（F14：Facebook + Instagram 数据拉取）
# ============================================================
# 获取方法（详见 README 或 CLAUDE.md）：
#   1. developers.facebook.com → Create App（Business 类型）
#   2. Graph API Explorer → 生成含 pages_read_engagement / read_insights /
#      instagram_manage_insights 权限的 Page Access Token
#   3. 通过 /oauth/access_token?grant_type=fb_exchange_token 换成长期 Token（60 天）
#   4. GET /me/accounts → 找到 page_id
#   5. GET /{page_id}?fields=instagram_business_account → 找到 ig_user_id

[meta_graph]
page_access_token = "EAAxxxxxx..."   # 长期 Page Access Token（60 天，建议定期刷新）
page_id           = "123456789"      # Facebook Page ID
ig_user_id        = "987654321"      # Instagram Business Account ID（可选，无 IG 需求留空）
app_id            = "111111111"      # Meta App ID（可选，续期时使用）

# ============================================================
# [gsheets] — Google Sheets 持久化（F10）
# ============================================================

[gsheets]
# 你的 Google Sheet 完整 URL（包含 /d/<id>/edit）。也可换成 spreadsheet_id = "<id>"。
spreadsheet_url = "https://docs.google.com/spreadsheets/d/REPLACE_WITH_YOUR_SHEET_ID/edit"
# 可选：指定 worksheet（tab）名称。省略则取第一个 worksheet。
worksheet_name = "data"

# 把从 Google Cloud Console 下载的 service account JSON 内容映射进来。
# 注意 private_key 内的换行需要保留为字面 "\n"。
[gsheets.service_account]
type = "service_account"
project_id = "REPLACE_WITH_PROJECT_ID"
private_key_id = "REPLACE_WITH_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
client_email = "REPLACE@REPLACE.iam.gserviceaccount.com"
client_id = "REPLACE_WITH_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/REPLACE"
universe_domain = "googleapis.com"

# ============================================================
# [youtube] — YouTube Analytics API（F15）
# ============================================================
# 获取方法：
#   1. Google Cloud Console → 创建项目 → 启用 YouTube Data API v3 + YouTube Analytics API
#   2. APIs & Services → OAuth consent screen → 添加 scope: yt-analytics.readonly + youtube.readonly
#      → Test users 添加你的 Gmail
#   3. Credentials → Create OAuth Client ID（Desktop App）→ 下载 JSON → 改名 client_secret.json
#   4. 在本地运行：python scripts/youtube_auth.py
#      → 浏览器弹出授权 → 终端打印 client_id / client_secret / refresh_token
#   注：refresh_token 永久有效，只需授权一次

[youtube]
client_id     = "xxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxx"
refresh_token = "1//xxx"

# ============================================================
# [linkedin] — LinkedIn Company Page API（F15）
# ============================================================
# 获取方法：
#   1. https://www.linkedin.com/developers/ → Create App → 关联公司主页
#   2. Products → 申请 "Marketing Developer Platform"（需审核，1-5 工作日）
#   3. Auth → OAuth 2.0 scopes 确认有 r_organization_social
#   4. 用 OAuth 2.0 Flow 授权 → 获取 access_token（60 天有效）
#   5. organization_id：你公司主页 URL 末尾的数字，如 linkedin.com/company/12345678/

[linkedin]
access_token    = "AQV..."
organization_id = "12345678"

# ============================================================
# [tiktok] — TikTok Business API（F15）
# ============================================================
# 获取方法：
#   1. https://business.tiktok.com/ → 确认是 Business Account
#   2. https://developers.tiktok.com/ → Create App → 添加 TikTok Business API
#   3. 申请权限：business.info.get + video.list
#   4. 通过 OAuth 2.0 授权流程获取 access_token + refresh_token
# 注：access_token 有效期 24 小时，系统自动用 refresh_token（30 天）续期
# ⚠️  TikTok 有机内容日粒度数据有限，建议配合 CSV 导出使用

[tiktok]
access_token  = "act.xxx"
refresh_token = "rft.xxx"
app_id        = "7xxx"
app_secret    = "xxx"
